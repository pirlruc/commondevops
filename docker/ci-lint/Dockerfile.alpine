# syntax=docker/dockerfile:1
# Org CI lint image (Alpine 3.24) — workflow linters + secrets/SAST CLIs.
# Refresh digests: docker login dhi.io && bash scripts/pin-dhi-digests.sh docker/ci-lint/Dockerfile.alpine
#
# Binary path discoveries (2026-08-12):
#   dhi.io/shellcheck:0-debian13 → /usr/local/bin/shellcheck (static; no Alpine DHI tag)
#   dhi.io/gitleaks:8-debian13   → /usr/local/bin/gitleaks   (static; no Alpine DHI tag)
#   hadolint/hadolint:2.12.0-alpine → /bin/hadolint
#   rhysd/actionlint:1.7.12      → /usr/local/bin/actionlint
#   ghcr.io/astral-sh/uv:0.12.0  → /uv (build stage only)
#
# shellcheck and gitleaks have no dhi.io alpine3.24 build. Both Debian donors are
# statically linked and run on musl (verified locally on alpine3.24-dev).
#
# No HEALTHCHECK: short-lived CI toolchain (CLI job container), not a supervised
# service (DOCKER-RUN-002 / DOCKER-RUN-006).

ARG BASE=dhi.io/python:3.13-alpine3.24-dev@sha256:7ee8eb32679a5729d91a30554b8791b5750e2491c04024b0b005ca226c4a0f7b

# ---------------------------------------------------------------------------
# pybuild — install Python CLIs; uv stays out of the final image (~53 MB).
# ---------------------------------------------------------------------------
# hadolint ignore=DL3006
FROM ${BASE} AS pybuild
COPY --from=ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 \
  /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
# semgrep>=1.168 brings PyJWT~=2.13 and urllib3<2.8. Override the fixed floors.
# mcp stays 1.29.0 — mcp 2.x drops FastMCP and breaks semgrep's MCP command.
RUN printf 'mcp==1.29.0\nPyJWT==2.14.0\nurllib3==2.8.0\n' > /tmp/uv-overrides.txt \
 && uv pip install --system --no-cache --override /tmp/uv-overrides.txt \
      'zizmor==1.29.0' \
      'yamllint>=1.35' \
      'semgrep==1.172.0' \
      'mcp==1.29.0' \
      'PyJWT==2.14.0' \
      'urllib3==2.8.0' \
 && rm -f /tmp/uv-overrides.txt

# ---------------------------------------------------------------------------
# Final image
# ---------------------------------------------------------------------------
# hadolint ignore=DL3006
FROM ${BASE}

LABEL org.opencontainers.image.title="ci-lint" \
      org.opencontainers.image.description="Short-lived CI toolchain image for lint and secrets/SAST: actionlint, hadolint, shellcheck, zizmor, yamllint, gitleaks, semgrep. Alpine 3.24 variant. Non-root 1000:1000, linux/amd64." \
      org.opencontainers.image.source="https://github.com/pirlruc/commondevops" \
      org.opencontainers.image.url="https://hub.docker.com/r/pirlruc/ci-lint" \
      org.opencontainers.image.documentation="https://hub.docker.com/r/pirlruc/ci-lint" \
      org.opencontainers.image.vendor="pirlruc" \
      org.opencontainers.image.licenses="MIT"

# Debian DHI donors: statically linked; no alpine3.24 DHI tag exists for these tools.
COPY --from=dhi.io/shellcheck:0-debian13@sha256:eb696ecbc0a6dbe57588d88c700c3da7cce3824f8c865795348f9b51c7524331 \
  /usr/local/bin/shellcheck /usr/local/bin/shellcheck
COPY --from=dhi.io/gitleaks:8-debian13@sha256:08b93b96ee818647ab1fb8e148bf8af4e1190b344e48b0e9bfa57eae98db8117 \
  /usr/local/bin/gitleaks /usr/local/bin/gitleaks
COPY --from=hadolint/hadolint:2.12.0-alpine@sha256:3c206a451cec6d486367e758645269fd7d696c5ccb6ff59d8b03b0e45268a199 \
  /bin/hadolint /usr/local/bin/hadolint
COPY --from=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 \
  /usr/local/bin/actionlint /usr/local/bin/actionlint

# Python packages + console scripts from pybuild (no uv binary in final).
COPY --from=pybuild /usr/lib/python3.13/site-packages /usr/lib/python3.13/site-packages
COPY --from=pybuild /usr/bin/semgrep /usr/bin/pysemgrep /usr/bin/zizmor /usr/bin/yamllint /usr/bin/

ENV PATH="/usr/local/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Drop build-only headers/dev packages when present (apk equivalent of the debian purge).
USER root
RUN set -eu; \
    for p in python3-dev musl-dev linux-headers zlib-dev expat-dev; do \
      if apk info -e "$p" >/dev/null 2>&1; then apk del --purge "$p"; fi; \
    done; \
    rm -rf /var/cache/apk/*

WORKDIR /workspace

# Non-root default user. DHI images have no useradd; write passwd/group directly.
# Login shell is /bin/sh — Alpine DHI has no bash (busybox ash via sh).
RUN printf 'ci:x:1000:1000::/home/ci:/bin/sh\n' >> /etc/passwd \
 && printf 'ci:x:1000:\n' >> /etc/group \
 && mkdir -p /home/ci \
 && chown -R 1000:1000 /home/ci /workspace
USER 1000:1000

ENTRYPOINT []
CMD ["sh"]
